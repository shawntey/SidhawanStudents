<UserControl x:Class="SidhawanForStudents.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SidhawanForStudents">
    <Grid>
        <Grid Margin="49,37,51,55">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"/>
                <StackPanel x:Name="ToolStrip" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,-12,0,0">
                    <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Margin="0,0,17,0"
                            Visibility="Collapsed" Click="Back_Click">
                        <local:Icon File="back" Width="38" Height="30"/>
                    </Button>
                    <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Margin="0,0,17,0"
                            Visibility="Collapsed" Click="Next_Click">
                        <local:Icon File="forward" Width="38" Height="30"/>
                    </Button>
                    <Button x:Name="EditBtn" Style="{StaticResource IconButton}"
                            Visibility="Collapsed" Click="Edit_Click">
                        <local:Icon File="edit" Width="30" Height="30"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="Box" Grid.Row="1" Margin="0,5,0,0" Background="White"
                    BorderBrush="#E4E4E4" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <WrapPanel x:Name="FilterBar"/>
                            <ContentControl x:Name="ToolHost" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                        <ContentControl x:Name="BandHost"/>
                        <ContentControl x:Name="BodyHost" Margin="0,0,0,24"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <local:MessageDialog x:Name="PopupDialog"/>
    </Grid>
</UserControl>