<UserControl x:Class="SidhawanForStudents.ChangePassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SidhawanForStudents">

    <UserControl.Resources>
        <!-- Read-only checklist items: not clickable and skipped by Tab -->
        <Style x:Key="RuleCheck" TargetType="CheckBox">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="Width" Value="418"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="49,37,49,30">
                <TextBlock Style="{StaticResource PageTitle}" Text="Password" VerticalAlignment="Top"/>

                <StackPanel Width="583" HorizontalAlignment="Center" Margin="0,80,0,0">
                    <local:PasswordPill x:Name="CurrentPw" Hint="Current Password" FontSize="16"/>
                    <local:PasswordPill x:Name="NewPw" Hint="New Password" Margin="0,16,0,0" FontSize="16"/>

                    <CheckBox x:Name="RuleLength" Style="{StaticResource RuleCheck}" Content="Must be 8-16 characters long" Margin="0,8,0,4"/>
                    <CheckBox x:Name="RuleUpper" Style="{StaticResource RuleCheck}" Content="Contains an uppercase letter"/>
                    <CheckBox x:Name="RuleLower" Style="{StaticResource RuleCheck}" Content="Contains a lowercase letter"/>
                    <CheckBox x:Name="RuleNumber" Style="{StaticResource RuleCheck}" Content="Contains a number"/>
                    <CheckBox x:Name="RuleSpecial" Style="{StaticResource RuleCheck}" Content="Contains a special character" Margin="0,0,0,8"/>

                    <local:PasswordPill x:Name="ConfirmPw" Hint="Confirm Password" Margin="0,10,0,0" FontSize="16"/>
                    <Button Style="{StaticResource PillButton}" Background="{StaticResource BrandDark}"
                            Content="Change Password" Width="180" Height="45" FontSize="16" Margin="0,25,0,0"
                            Click="Change_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <local:MessageDialog x:Name="Dialog"/>
    </Grid>
</UserControl>
