<UserControl x:Class="SidhawanForStudents.PasswordPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SidhawanForStudents"
             Height="64" FontSize="22" Padding="40,0,80,0">
    <Border Background="{StaticResource Brand}" CornerRadius="32" Effect="{StaticResource PillShadow}">
        <Grid>
            <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <PasswordBox x:Name="Hidden" Style="{StaticResource BarePwd}" Foreground="White"
                             CaretBrush="White" PasswordChanged="Hidden_PasswordChanged"/>
                <TextBox x:Name="Shown" Style="{StaticResource BareBox}" Foreground="White" CaretBrush="White"
                         Visibility="Collapsed" TextChanged="Shown_TextChanged"/>
                <TextBlock x:Name="HintText" Foreground="#8CCB90" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
            <ToggleButton x:Name="Eye" Click="Eye_Click"
                          HorizontalAlignment="Right" 
                          VerticalAlignment="Center"
                          Width="26" Height="24"
                          Margin="8,8,15,8">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Image x:Name="Icon" Source="/Images/Icon/eye_open.png" Stretch="Uniform"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Source" Value="/Images/Icon/eye_closed.png"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>