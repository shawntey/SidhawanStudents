<UserControl x:Class="SidhawanForStudents.MessageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SidhawanForStudents"
             Width="582" Height="292" Visibility="Collapsed"
             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,131,0,0">
    <Border Background="#EAEAEA" CornerRadius="12" ClipToBounds="True" BorderThickness="1.5" BorderBrush="{StaticResource BrandDark}">
        <Border.Effect>
            <DropShadowEffect Color="White" ShadowDepth="8" Direction="315" BlurRadius="0" Opacity="1"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header / Close Button -->
            <Button Grid.Row="0" Style="{StaticResource IconButton}" 
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" 
                    Click="Close_Click">
                <local:Icon File="close" Width="25" Height="25"/>
            </Button>

            <!-- Notice Panel -->
            <StackPanel x:Name="NoticePanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid x:Name="IconHost" Width="130" Height="130" HorizontalAlignment="Center" Margin="0,-35,0,0"/>
                <TextBlock x:Name="NoticeText" FontFamily="Verdana" FontWeight="Normal" FontSize="18"
                           Foreground="{StaticResource BrandDark}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>

            <!-- Confirm Panel -->
            <StackPanel x:Name="ConfirmPanel" Grid.Row="1" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="ConfirmText" 
                       FontFamily="Verdana" 
                       FontWeight="Normal"
                       FontSize="20"
                       Margin="20,20,20,20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrandDark}"
                       TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,30,0,0">
                    <Button Style="{StaticResource AnswerYes}" Content="Yes" Click="Yes_Click"/>
                    <Button Style="{StaticResource AnswerNo}" Content="No" Margin="15,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Terms Panel -->
            <Grid x:Name="TermsPanel" Grid.Row="1" Visibility="Collapsed" Margin="30,0,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TermsTitle" FontFamily="Verdana" FontWeight="Bold" FontSize="20"
               Foreground="{StaticResource Brand}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TermsText" FontFamily="Verdana" FontSize="13"
                   Foreground="#2c3e50" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>