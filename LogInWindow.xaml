<Window x:Class="SidhawanForStudents.LogInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SidhawanForStudents"
        Title="Sidhawan - Student" WindowState="Maximized" Background="Black"
        FontFamily="{StaticResource BodyFont}">
    <Viewbox Stretch="UniformToFill">
        <Canvas Width="1456" Height="822" ClipToBounds="True">

            <Image Source="/Images/login_bg.png" Width="1456" Height="822" Stretch="Fill"/>
            <Image Source="/Images/seal.png" Canvas.Left="22" Canvas.Top="22" Width="48" Height="48"/>

            <TextBlock Canvas.Left="46" Canvas.Top="100" Foreground="White"
                       FontFamily="Verdana" FontWeight="Bold" FontSize="56"
                       LineStackingStrategy="BlockLineHeight" LineHeight="61">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="4" Opacity="0.5"/>
                </TextBlock.Effect>
                <Run Text="Edukasyon para"/><LineBreak/>
                <Run Text="sa sarili, pamilya"/><LineBreak/>
                <Run Text="at bayan."/>
            </TextBlock>
            <Canvas>
                <Canvas.RenderTransform>
                    <TranslateTransform Y="-40"/>
                </Canvas.RenderTransform>
                <Image Source="/Images/seal.png" Canvas.Left="1003" Canvas.Top="109" Width="265" Height="248" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Image Source="/Images/plp_banner.png" Canvas.Left="995" Canvas.Top="362" Width="264" Height="58"/>

                <TextBlock Canvas.Left="905" Canvas.Top="420" Text="Welcome!" Foreground="White"
                       FontSize="44" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock Canvas.Left="907" Canvas.Top="475" Text="Enter your account details"
                       Foreground="White" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBox x:Name="UserId" Style="{StaticResource PillTextBox}" Tag="Student Number"
                     Canvas.Left="907" Canvas.Top="520" Width="445" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <local:PasswordPill x:Name="Pwd" Hint="Password" Height="53" FontSize="17"
                                Padding="21,0,21,0"
                                Canvas.Left="886" Canvas.Top="590" Width="491" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <Button Content="Log in" Style="{StaticResource PillButton}"
                    Background="{StaticResource BrandDark}"
                    Canvas.Left="1057" Canvas.Top="686" Width="149" Height="54"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Click="LogIn_Click"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</Window>