<Window x:Class="SidhawanForStudents.Window2"
        xmlns:local="clr-namespace:SidhawanForStudents"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidhawan" WindowState="Maximized" MinWidth="1000" MinHeight="620"
        Background="White" FontFamily="{StaticResource BodyFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="89"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top info bar -->
        <Border Grid.Row="0" Background="{StaticResource Brand}">
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <local:Icon File="location" Width="12" Height="12"/>
                <TextBlock Style="{StaticResource TopBarText}" VerticalAlignment="Center" Margin="6,0,0,0"
               Text="12-B Alcalde Jose, Pasig, 1600 Metro Manila"/>

                <local:Icon File="phone" Width="12" Height="12" Margin="20,0,0,0"/>
                <TextBlock Style="{StaticResource TopBarText}" VerticalAlignment="Center" Margin="6,0,0,0"
               Text="(02) 8628 1013"/>

                <local:Icon File="mail" Width="14" Height="12" Margin="20,0,0,0"/>
                <TextBlock Style="{StaticResource TopBarText}" VerticalAlignment="Center" Margin="6,0,0,0"
               Text="inquiry@plpasig.edu.ph"/>
            </StackPanel>
        </Border>

        <!-- Header -->
        <Border Grid.Row="1" Background="White" Panel.ZIndex="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.25"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Images/seal.png" Width="60" Height="60" Margin="24,0,15,0"/>
                <Image Grid.Column="1" Source="/Images/plp_banner.png" Height="58" Stretch="Uniform"/>
                <Button Content="Log Out" Style="{StaticResource LogOutButton}"
                    Grid.Column="3" Height="54"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    FontSize="16" FontWeight="SemiBold" Click="LogOut_Click"/>
                <Ellipse x:Name="HeaderAvatar" Grid.Column="4" Width="54" Height="54" Margin="15,0,20,0"/>
            </Grid>
        </Border>
        <!-- Body: sidebar + content card -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid x:Name="Sidebar" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Ellipse x:Name="SideAvatar" Width="180" Height="180" Margin="0,43,0,0"/>
                    <TextBlock Margin="0,23,0,0" TextAlignment="Center" Foreground="White"
                               FontSize="31" FontWeight="Bold"
                               LineStackingStrategy="BlockLineHeight" LineHeight="42">
                        <Run Text="Welcome,"/><LineBreak/><Run x:Name="WelcomeName" Text="Y/N!"/>
                    </TextBlock>
                </StackPanel>

                <ListBox x:Name="NavList" Grid.Row="1" Margin="0,14,0,0" Background="Transparent"
                         BorderThickness="0" Focusable="False" FontFamily="Verdana" FontSize="15"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" 
                                                Margin="40,0,0,1.5" 
                                                MinWidth="205"
                                                HorizontalAlignment="Left" 
                                                BorderBrush="Transparent" 
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True"
                                                CornerRadius="8">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHover}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavActive}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Button Content="Terms of Service " Style="{StaticResource IconButton}"
                    Background="{StaticResource BrandDark}"
                    FontSize="11" FontWeight="SemiBold" 
                    Grid.Column="1"
                    Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,1,10,15" Foreground="White" Click="TOS_Click"/>
                <Button Content="| Privacy Policy |" Style="{StaticResource IconButton}"
                    Background="{StaticResource BrandDark}"
                    FontSize="11" FontWeight="SemiBold" 
                    Grid.Column="2"
                    Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="37,1,10,15" Foreground="White" Click="PrivPolicy_Click"/>
                <Button Content=" Guidelines" Style="{StaticResource IconButton}"
                    Background="{StaticResource BrandDark}"
                    FontSize="11" FontWeight="SemiBold" 
                    Grid.Column="3"
                    Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="17,1,30,15" Foreground="White" Click="Guidelines_Click"/>
            </Grid>

            <!-- White panel -->
            <Border Grid.Column="1" Margin="24,25,19,27" Background="White" CornerRadius="50">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <ContentControl x:Name="Body"/>
            </Border>
        </Grid>
        <local:MessageDialog x:Name="Dialog" 
                             Grid.RowSpan="3" Panel.ZIndex="10"
                             VerticalAlignment="Center" 
                             Margin="286,100,0,0"/>
    </Grid>
</Window>